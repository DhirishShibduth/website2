{
  "name": "@component-library/root",
  "version": "0.1.0",
  "private": true,
  "description": "A modern component library for Angular",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "install:all": "npm install && npm run build:cli",
    "build:ui": "cd packages/ui && npm run build",
    "build:cli": "cd packages/cli && npm run build",
    "build": "npm run build:ui && npm run build:cli",
    "storybook": "cd packages/ui && npm run storybook",
    "build-storybook": "cd packages/ui && npm run build-storybook",
    "demo": "cd examples/demo-app && npm start",
    "component-library": "node packages/cli/dist/index.js"
  },
  "keywords": [
    "angular",
    "components",
    "ui",
    "tailwind",
    "component-library",
    "headless"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "~5.5.0"
  },
  "overrides": {
    "@angular/compiler": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular-devkit/build-angular": "^18.2.0"
  }
}
